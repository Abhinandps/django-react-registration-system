# Django Environment Configuration Template
DEBUG=True
SECRET_KEY=replace-this-with-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: Set DATABASE_URL for PostgreSQL
# Example: postgres://username:password@localhost:5432/dbname
DATABASE_URL=postgres://postgres:postgres@localhost:5432/college_admissions

# CORS: Frontend client origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload Limits
MAX_PHOTO_SIZE=2097152
MAX_DOCUMENT_SIZE=5242880
